# Frontend Environment Variables
# In Vite, variables must be prefixed with VITE_ to be exposed to the client
VITE_API_BASE_URL=http://localhost:5001/api

# Map Configuration
VITE_MAP_DEFAULT_LATITUDE=20.5937
VITE_MAP_DEFAULT_LONGITUDE=78.9629
VITE_MAP_DEFAULT_ZOOM=5

# OpenStreetMap tile provider
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Reverse geocoding provider
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse