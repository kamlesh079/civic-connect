# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Public backend URL used to build image URLs
# Local development:
PUBLIC_API_URL=http://localhost:5001

# Production example:
# PUBLIC_API_URL=https://api.yourdomain.com

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/civicconnect

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Upload limits
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_ISSUE=5